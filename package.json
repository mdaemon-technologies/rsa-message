{
  "name": "@mdaemon/rsa-message",
  "type": "module",
  "version": "2.2.4",
  "description": "RSA message encryption, signing, decryption, and verification using webcrypto or node crypto",
  "main": "dist/rsa-message.cjs",
  "module": "dist/rsa-message.mjs",
  "browser": "dist/rsa-message.umd.js",
  "common": "dist/rsa-message.cjs",
  "typings": "dist/rsa-message.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest --forceExit",
    "watch": "jest --watchAll",
    "pub": "npm run build && npm run test && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdaemon-technologies/rsa-message.git"
  },
  "keywords": [
    "rsa",
    "aes",
    "encypt",
    "decrypt",
    "sign",
    "verify",
    "message",
    "messaging"
  ],
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "LGPL-2.1",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/rsa-message/issues"
  },
  "homepage": "https://github.com/mdaemon-technologies/rsa-message#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/base64util": "^2.2.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "rollup": "^4.40.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/rsa-message.d.ts",
      "import": "./dist/rsa-message.mjs",
      "require": "./dist/rsa-message.cjs",
      "browser": "./dist/rsa-message.umd.js",
      "default": "./dist/rsa-message.mjs"
    }
  },
  "dependencies": {
    "base64util": "^2.2.0"
  }
}
